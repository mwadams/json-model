<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>corvus-bench</AssemblyName>
    <RootNamespace>CorvusBench</RootNamespace>
    <!-- Native AOT, as the corvus-net-optcold implementation of the JSON Schema Benchmark: the evaluator runs compiled
         ahead of time from the first check (a JIT build starts in unoptimised code, and the per-value loops time that),
         and the package's static profile (applied by its buildTransitive targets) guides the AOT compiler. The
         instruction set is that of the machine building the image, like -march=native. The schema is interpreted:
         runtime code generation needs a JIT. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- JsonSchemaEvaluator.ToProgramImage / FromProgramImage ship in 5.6.0+ -->
    <PackageReference Include="Corvus.Text.Json" Version="*" />
  </ItemGroup>

</Project>
